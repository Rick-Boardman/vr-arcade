{
  "name": "@rb/arcade",
  "version": "0.5.0",
  "description": "Shared game modules (audio, player presentation, seeded courses, racing, Magna game entry) over Halo and game-owned assets and policies",
  "type": "module",
  "exports": {
    "./audio": "./src/audio.js",
    "./presentation": "./src/presentation.js",
    "./course": "./src/course.js",
    "./racing": "./src/racing.js",
    "./entry": "./src/entry.js"
  },
  "files": ["src"],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "build": "npm run check && npm test"
  },
  "engines": { "node": ">=24" },
  "peerDependencies": {
    "@rb/halo": ">=0.2.5"
  },
  "peerDependenciesMeta": {
    "@rb/halo": { "optional": true }
  },
  "devDependencies": {
    "@rb/halo": "github:Rick-Boardman/vr-halo#v0.2.5"
  }
}
